{
  "name": "streaming-platform",
  "version": "1.0.0",
  "description": "A monorepo streaming platform",
  "private": true,
  "engines": { "node": ">=24 <25" },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "npm run build --workspace web",
    "lint": "npm run lint --workspace @streamline/server && npm run lint --workspace web",
    "format": "turbo run format",
    "test": "npm run test --workspace @streamline/server",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "2.11.13"
  },
  "keywords": [
    "streaming",
    "monorepo",
    "platform"
  ],
  "author": "",
  "license": "MIT"
}
