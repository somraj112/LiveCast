# Database Configuration

# Configure your database connection details here.

DATABASE_URL=postgresql://livecast:local-development-only@localhost:5433/livecast_dev
# Optional direct connection for migrations when DATABASE_URL uses a pooler.
DIRECT_DATABASE_URL=

# Redis Configuration
REDIS_URL=redis://localhost:6380

# API Configuration
PORT=3001
API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Managed broadcasting (server-only secrets; never prefix these with NEXT_PUBLIC_)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
# Base64-encoded RSA private PEM from your Mux playback signing key
MUX_SIGNING_PRIVATE_KEY=
# Generate once with: openssl rand -hex 32. Preserve it to decrypt saved ingest keys.
STREAM_KEY_ENCRYPTION_KEY=
# Default true: watermarked, limited test streams. Explicit false enables billable broadcasts.
MUX_TEST_MODE=true

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Authentication
# Generate each value independently with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_a_random_access_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_refresh_secret_at_least_32_characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
REFRESH_COOKIE_NAME=livecast_refresh

# Environment
NODE_ENV=development
LOG_LEVEL=info
TRUST_PROXY_HOPS=0
API_REPLICAS=1
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=20
# Optional locally, required in production. Generate independently from JWT keys.
METRICS_TOKEN=
