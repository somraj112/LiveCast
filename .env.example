# Database Configuration

# Configure your database connection details here.

DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/livecast?schema=public

DB_HOST=localhost
DB_PORT=5432
DB_NAME=livecast
DB_USER=postgres
DB_PASSWORD=your_password_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# API Configuration
PORT=3001
API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Authentication
# Generate each value independently with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_a_random_access_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_refresh_secret_at_least_32_characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
REFRESH_COOKIE_NAME=livecast_refresh

# Environment
NODE_ENV=development
