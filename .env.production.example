# Copy to an ignored .env.production on the deployment host, chmod 600.
# Never use this example's placeholders as credentials.
NODE_ENV=production
SITE_ADDRESS=livecast.example.com
FRONTEND_URL=https://livecast.example.com
DATABASE_URL=postgresql://runtime_user:REPLACE@database.example.com:5432/livecast_production?sslmode=verify-full
# Direct connection and migration role; remove from the runtime secret store when
# deploying the migration job and API separately. Do not use a transaction pooler.
DIRECT_DATABASE_URL=postgresql://migration_user:REPLACE@database.example.com:5432/livecast_production?sslmode=verify-full
REDIS_URL=rediss://default:REPLACE@redis.example.com:6379
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
METRICS_TOKEN=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
LOG_LEVEL=info
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=20
TRUST_PROXY_HOPS=1
API_REPLICAS=1
# Set all Mux fields together to enable broadcasting. Keep test mode for staging.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
STREAM_KEY_ENCRYPTION_KEY=
MUX_TEST_MODE=true
